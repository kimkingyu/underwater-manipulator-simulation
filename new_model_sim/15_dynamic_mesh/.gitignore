# Keep local execution ledgers, authorizations and archived machine-specific code private.
/runs/
/frozen/*authorization*.json
/frozen/source_archive*/

# Publish only the concise validation record and explicitly curated native evidence.
/reports/*
!/reports/validation_summary.json
!/reports/evidence/
