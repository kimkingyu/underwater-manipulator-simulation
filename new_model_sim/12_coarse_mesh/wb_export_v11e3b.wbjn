# encoding: utf-8
# auvm_water_v11e3.wbpj meshed (4.66 M) but the Fluent mesh write failed, most likely because the helper
# named selection gap_faces overlaps wall_l1/wall_l2/wall_link3. Keep the face sizing but scope it by
# the 4 face ids directly, delete the gap_faces named selection, regenerate, then update the component
# (writes FFF.msh) and save. Logs every step.
SetScriptVersion(Version="24.2.133")
import System
from System.IO import File
from System.Text import Encoding

D = r"D:\work4\new_model_sim\12_coarse_mesh"
TRACE = D + r"\wb_export_v11e3b_trace.txt"
PROJECT = D + r"\auvm_water_v11e3.wbpj"
INNER = D + r"\mesh_v11e3b_messages.txt"
NL = System.Environment.NewLine


def log(s):
    File.AppendAllText(TRACE, System.String.Concat(s, NL), Encoding.UTF8)


def step(label, fn):
    log(label)
    try:
        fn()
        log("  OK")
        return True
    except System.Exception, ex:
        log("  .NET ERROR:")
        log(ex.ToString()[:3000])
    except Exception, e:
        log("  python ERROR")
        try:
            log(e.clsException.ToString()[:3000])
        except Exception:
            log("  (no text)")
    return False


INSIDE = r'''
import codecs
out = codecs.open(r"%s", "w", "utf-8")
try:
    m = ExtAPI.DataModel.Project.Model
    mesh = m.Mesh
    ns = dict((s.Name, s) for s in m.NamedSelections.Children)
    ids = list(ns["gap_faces"].Location.Ids)
    out.write("gap face ids %%s\n" %% ids)
    sz = [c for c in mesh.Children if c.GetType().Name == "Sizing" and c.Name == "size_gap_faces"][0]
    sel = ExtAPI.SelectionManager.CreateSelectionInfo(SelectionTypeEnum.GeometryEntities)
    sel.Ids = ids
    sz.Location = sel
    out.write("sizing scoped to ids, size %%s\n" %% sz.ElementSize)
    ns["gap_faces"].Delete()
    out.write("named selections now %%s\n" %% [s.Name for s in m.NamedSelections.Children])
    mesh.ClearGeneratedData()
    mesh.GenerateMesh()
    for msg in ExtAPI.Application.Messages:
        if msg.Severity.ToString() != "Warning":
            out.write("  [%%s] %%s\n" %% (msg.Severity, msg.DisplayString))
    out.write("mesh_nodes %%s\n" %% mesh.Nodes)
    out.write("mesh_elements %%s\n" %% mesh.Elements)
    try:
        mesh.MeshMetric = MeshMetricType.Skewness
        out.write("skewness max %%s avg %%s\n" %% (mesh.Maximum, mesh.Average))
    except Exception, e:
        out.write("metric err %%s\n" %% e)
except Exception, e:
    out.write("INSIDE ERROR %%s\n" %% e)
finally:
    out.close()
''' % INNER


def run():
    if not step("1 open v11e3", lambda: Open(FilePath=PROJECT)):
        return
    s = GetAllSystems()[0]
    comp = s.GetComponent(Name="Mesh")
    mesh = s.GetContainer(ComponentName="Mesh")
    ok = step("2 meshing: rescope sizing, drop helper NS, regenerate", lambda: (
        mesh.Edit(Interactive=False),
        mesh.SendCommand(Language="Python", Command=INSIDE),
        mesh.Exit()))
    ok = ok and step("3 update mesh component (writes FFF.msh)", lambda: comp.Update(AllDependencies=True))
    step("4 save", lambda: Save(Overwrite=True))


try:
    run()
except System.Exception, ex:
    log("FATAL .NET: " + ex.ToString())
except Exception, e:
    log("FATAL python")
log("END")
