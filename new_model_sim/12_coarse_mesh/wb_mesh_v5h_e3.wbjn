# encoding: utf-8
# Real hull (v5h geometry) with the E3 arm settings, on a COPY of auvm_water_v5h.wbpj
# (auvm_water_v5h_e3.wbpj; v5h untouched, no msh export). Hull treatment varied; element census by distance.
SetScriptVersion(Version="24.2.133")
import System
from System.IO import File, Directory
from System.Text import Encoding

D = r"D:\work4\new_model_sim\12_coarse_mesh"
TRACE = D + r"\wb_mesh_v5h_e3_trace.txt"
SOURCE_PROJECT = r"D:\work4\new_model_sim\09_seal_j2j3\auvm_water_v5h.wbpj"
PROJECT = D + r"\auvm_water_v5h_e3.wbpj"
INNER = D + r"\mesh_v5h_e3_messages.txt"
NL = System.Environment.NewLine


def log(s):
    File.AppendAllText(TRACE, System.String.Concat(s, NL), Encoding.UTF8)


def step(label, fn):
    log(label)
    try:
        fn()
        log("  OK")
        return True
    except System.Exception, ex:
        log("  .NET ERROR:")
        log(ex.ToString()[:3000])
    except Exception, e:
        log("  python ERROR")
    return False


INSIDE = r'''
import codecs, math, time
out = codecs.open(r"%s", "w", "utf-8")
C = (0.0, -0.10, -0.45)
R = [0.05, 0.1, 0.2, 0.4, 10.0]
def w(s):
    out.write(s + "\n"); out.flush()
def put(obj, name, value):
    try:
        setattr(obj, name, value)
        return "%%s=%%s" %% (name, getattr(obj, name))
    except Exception, e:
        return "FAILED %%s: %%s" %% (name, e)
def census():
    md = ExtAPI.DataModel.MeshDataByName("Global")
    counts = [0] * len(R)
    for eid in md.ElementIds:
        el = md.ElementById(eid)
        ps = [md.NodeById(k) for k in el.NodeIds]
        cx = sum(p.X for p in ps) / len(ps); cy = sum(p.Y for p in ps) / len(ps); cz = sum(p.Z for p in ps) / len(ps)
        d = math.sqrt((cx - C[0]) ** 2 + (cy - C[1]) ** 2 + (cz - C[2]) ** 2)
        for i, r in enumerate(R):
            if d < r:
                counts[i] += 1
                break
    return counts
def gen(tag, r):
    w("STEP %%s %%s" %% (tag, [x for x in r if "FAILED" in x] or "all set"))
    t0 = time.time()
    mesh.ClearGeneratedData()
    try:
        mesh.GenerateMesh()
    except Exception, e:
        w("  GenerateMesh raised %%s" %% e)
    sk = ""
    try:
        mesh.MeshMetric = MeshMetricType.Skewness
        sk = "skew max %%s avg %%s" %% (mesh.Maximum, mesh.Average)
    except Exception, e:
        sk = "metric err %%s" %% e
    w("  RESULT %%s elements %%s nodes %%s %%s %%.0fs" %% (tag, mesh.Elements, mesh.Nodes, sk, time.time() - t0))
    errs = [msg.DisplayString for msg in ExtAPI.Application.Messages if msg.Severity.ToString() == "Error"]
    for e in errs:
        w("    [Error] %%s" %% e)
    try:
        ExtAPI.Application.Messages.Clear()
    except Exception:
        pass
    if mesh.Elements > 0 and not errs:
        w("  census <5cm,5-10,10-20,20-40,>40cm: %%s" %% census())
try:
    m = ExtAPI.DataModel.Project.Model
    mesh = m.Mesh
    sz = dict((c.Name, c) for c in mesh.Children if c.GetType().Name == "Sizing")
    ns = dict((x.Name, x) for x in m.NamedSelections.Children)
    w("sizings %%s" %% sorted(sz))
    # E3 global + arm settings
    r = [put(mesh, "MaximumSize", Quantity("200 [mm]")), put(mesh, "ElementSize", Quantity("150 [mm]")),
         put(mesh, "CaptureCurvature", False), put(mesh, "CaptureProximity", False),
         put(mesh, "MinimumSize", Quantity("0.3 [mm]")), put(mesh, "GrowthRate", 1.4), put(mesh, "GrowthRateSF", 1.4)]
    for n, c in sz.items():
        r.append(n + ":" + put(c, "GrowthRate", 1.4))
        if n in ("size_wall_jaw1", "size_wall_jaw2", "size_wall_pin4"):
            r.append(n + ":" + put(c, "ElementSize", Quantity("3 [mm]")))
        elif n in ("size_wall_link3", "size_wall_l2", "size_wall_l1"):
            r.append(n + ":" + put(c, "ElementSize", Quantity("5 [mm]")))
        elif n == "size_gap_faces":
            r.append(n + ":" + put(c, "ElementSize", Quantity("1 [mm]")))
        elif n.startswith("soi_"):
            r.append(n + ":" + put(c, "ElementSize", Quantity("0.4 [mm]")))
    hull = mesh.AddSizing()
    hull.Location = ns["wall_auv"]
    hull.Name = "size_wall_auv"
    r.append(put(hull, "GrowthRate", 1.4))
    r.append(put(hull, "ElementSize", Quantity("40 [mm]")))
    try:
        hull.Behavior = SizingBehavior.Soft
    except Exception, e:
        r.append("FAILED behavior %%s" %% e)
    if "gap_faces" in ns:
        gsz = [c for c in mesh.Children if c.GetType().Name == "Sizing" and c.Name == "size_gap_faces"][0]
        gsel = ExtAPI.SelectionManager.CreateSelectionInfo(SelectionTypeEnum.GeometryEntities)
        gsel.Ids = list(ns["gap_faces"].Location.Ids)
        gsz.Location = gsel
        ns["gap_faces"].Delete()
        w("gap_faces NS replaced by ids %%s" %% list(gsel.Ids))
    else:
        w("no gap_faces NS (already scoped by ids)")
    w("named selections %%s" %% [x.Name for x in m.NamedSelections.Children])
    gen("V5H_E3_hull_soft40", r)
except Exception, e:
    w("INSIDE ERROR %%s" %% e)
finally:
    out.close()
''' % INNER


def run():
    if not step("1 open v5h", lambda: Open(FilePath=SOURCE_PROJECT)):
        return
    if not step("2 save as v5h_e3_trials (new file)", lambda: Save(FilePath=PROJECT, Overwrite=False)):
        return
    s = GetAllSystems()[0]
    mesh = s.GetContainer(ComponentName="Mesh")
    comp = s.GetComponent(Name="Mesh")
    ok = step("3 settings + generate", lambda: (mesh.Edit(Interactive=False),
                                               mesh.SendCommand(Language="Python", Command=INSIDE),
                                               mesh.Exit()))
    step("4 mkdir MECH", lambda: Directory.CreateDirectory(D + r"\auvm_water_v5h_e3_files\dp0\FFF\MECH"))
    ok = ok and step("5 update mesh component (writes FFF.msh)", lambda: comp.Update(AllDependencies=True))
    step("6 save", lambda: Save(Overwrite=True))


try:
    run()
except System.Exception, ex:
    log("FATAL .NET: " + ex.ToString())
log("END")
