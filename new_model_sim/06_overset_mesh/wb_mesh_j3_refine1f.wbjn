# encoding: utf-8
# Works on the fork auvm_overset_j3r1c.wbpj (original auvm_overset_cfd.wbpj untouched).
# Inside j3 Meshing: list size-related Mesh properties, apply curvature + proximity sizing with the
# real property names, call GenerateMesh() in Meshing itself, report counts, then export nothing
# (Fluid Flow writes FFF-3.msh on component update). Launch with run_wb_fullenv.py.
SetScriptVersion(Version="24.2.133")
import System
from System.IO import File
from System.Text import Encoding

D = r"D:\work4\new_model_sim\06_overset_mesh"
TRACE = D + r"\wb_mesh_j3_refine1f_trace.txt"
PROJECT = D + r"\auvm_overset_j3r1c.wbpj"
INNER = D + r"\settings_j3r1f.txt"
NL = System.Environment.NewLine


def log(s):
    File.AppendAllText(TRACE, System.String.Concat(s, NL), Encoding.UTF8)


def step(label, fn):
    log(label)
    try:
        fn()
        log("  OK")
        return True
    except System.Exception, ex:
        log("  .NET ERROR:")
        log(ex.ToString())
    except Exception, e:
        log("  python ERROR")
        try:
            log(e.clsException.ToString())
        except Exception:
            log("  (no text)")
    return False


INSIDE = r'''
import codecs
out = codecs.open(r"%s", "w", "utf-8")
try:
    m = ExtAPI.DataModel.Project.Model
    mesh = m.Mesh
    out.write("BEFORE nodes %%s elements %%s\n" %% (mesh.Nodes, mesh.Elements))
    def put(name, value):
        try:
            setattr(mesh, name, value)
            out.write("set %%s = %%s\n" %% (name, getattr(mesh, name)))
        except Exception, e:
            out.write("FAILED %%s : %%s\n" %% (name, e))
    put("UseAdaptiveSizing", False)
    put("CaptureCurvature", True)
    put("CurvatureNormalAngle", Quantity("12 [deg]"))
    put("CaptureProximity", True)
    put("GrowthRate", 1.15)
    put("MaximumSize", Quantity("4 [mm]"))
    put("MinimumSize", Quantity("0.05 [mm]"))
    put("ProximityMinimumSize", Quantity("0.05 [mm]"))
    put("ProximityGapFactor", 3.0)
    put("ProximitySizeSources", ProximitySFSourcesType.FacesAndEdges)
    out.write("CLEAR + GENERATE\n")
    mesh.ClearGeneratedData()
    mesh.GenerateMesh()
    out.write("MESSAGES\n")
    try:
        for msg in ExtAPI.Application.Messages:
            out.write("  [%%s] %%s\n" %% (msg.Severity, msg.DisplayString))
            try:
                ids = list(msg.Location.Ids) if msg.Location is not None else []
                if ids:
                    out.write("     location ids %%s\n" %% ids[:20])
            except Exception:
                pass
    except Exception, e:
        out.write("  messages error %%s\n" %% e)
    out.write("mesh_nodes %%s\n" %% mesh.Nodes)
    out.write("mesh_elements %%s\n" %% mesh.Elements)
    items = m.NamedSelections.Children if m.NamedSelections is not None else []
    for s in items:
        out.write("  ns %%s entities %%d\n" %% (s.Name, len(list(s.Location.Ids))))
except Exception, e:
    out.write("INSIDE ERROR %%s\n" %% e)
finally:
    out.close()
''' % INNER


def run():
    if not step("1 open fork", lambda: Open(FilePath=PROJECT)):
        return
    s = GetSystem(Name="FFF 3")
    log("  display text: " + s.DisplayText)
    comp = s.GetComponent(Name="Mesh")
    mesh = s.GetContainer(ComponentName="Mesh")
    ok = step("2 meshing: settings + GenerateMesh", lambda: (mesh.Edit(Interactive=False),
                                                           mesh.SendCommand(Language="Python", Command=INSIDE),
                                                           mesh.Exit()))
    ok = ok and step("3 update j3 component (writes FFF-3.msh)", lambda: comp.Update(AllDependencies=True))
    step("4 save", lambda: Save(Overwrite=True))


try:
    run()
except System.Exception, ex:
    log("FATAL .NET: " + ex.ToString())
except Exception, e:
    log("FATAL python")
log("END")
