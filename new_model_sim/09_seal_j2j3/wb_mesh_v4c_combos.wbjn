# encoding: utf-8
# auvm_water_v4c.wbpj: the proximity preset fails validation ("element size must be <= max size and
# >= proximity min size") even in a fresh project. Inside one Meshing session, try size combinations in
# order and keep the first that produces nodes > 0; every attempt and its new messages are logged.
# Then update the component (writes FFF.msh) only if one succeeded, and save.
SetScriptVersion(Version="24.2.133")
import System
from System.IO import File
from System.Text import Encoding

D = r"D:\work4\new_model_sim\09_seal_j2j3"
TRACE = D + r"\wb_mesh_v4c_combos_trace.txt"
PROJECT = D + r"\auvm_water_v4c.wbpj"
INNER = D + r"\mesh_v4c_combos.txt"
FLAG = D + r"\mesh_v4c_combos_success.txt"
NL = System.Environment.NewLine


def log(s):
    File.AppendAllText(TRACE, System.String.Concat(s, NL), Encoding.UTF8)


def step(label, fn):
    log(label)
    try:
        fn()
        log("  OK")
        return True
    except System.Exception, ex:
        log("  .NET ERROR:")
        log(ex.ToString()[:3000])
    except Exception, e:
        log("  python ERROR")
        try:
            log(e.clsException.ToString()[:3000])
        except Exception:
            log("  (no text)")
    return False


INSIDE = r'''
import codecs
out = codecs.open(r"%s", "w", "utf-8")
# (label, element=max size, min size, proximity min size, curvature on)
COMBOS = [("A", "200 [mm]", "0.05 [mm]", "0.05 [mm]", True),
          ("B", "100 [mm]", "0.02 [mm]", "0.02 [mm]", True),
          ("C", "100 [mm]", "0.05 [mm]", "0.05 [mm]", True),
          ("D", "50 [mm]", "0.02 [mm]", "0.02 [mm]", True),
          ("E", "100 [mm]", "0.02 [mm]", "0.02 [mm]", False)]
try:
    m = ExtAPI.DataModel.Project.Model
    mesh = m.Mesh
    def put(name, value):
        try:
            setattr(mesh, name, value)
            return "%%s=%%s" %% (name, getattr(mesh, name))
        except Exception, e:
            return "FAILED %%s:%%s" %% (name, e)
    out.write("sizings %%s\n" %% [c.Name for c in mesh.Children if c.GetType().Name == "Sizing"])
    winner = None
    for label, big, small, prox, curv in COMBOS:
        sets = [put("CaptureCurvature", curv), put("MinimumSize", Quantity(small)),
                put("ProximityMinimumSize", Quantity(prox)), put("MaximumSize", Quantity(big)),
                put("ElementSize", Quantity(big)), put("CaptureProximity", True),
                put("ProximityGapFactor", 3.0), put("ProximitySizeSources", ProximitySFSourcesType.Faces),
                put("GrowthRate", 1.2)]
        out.write("== combo %%s : %%s\n" %% (label, "; ".join(sets)))
        n0 = len(list(ExtAPI.Application.Messages))
        mesh.ClearGeneratedData()
        try:
            mesh.GenerateMesh()
        except Exception, e:
            out.write("   GenerateMesh raised %%s\n" %% e)
        msgs = list(ExtAPI.Application.Messages)
        for msg in msgs:
            out.write("   [%%s] %%s\n" %% (msg.Severity, msg.DisplayString))
        out.write("   messages before %%d after %%d nodes %%s elements %%s\n" %% (n0, len(msgs), mesh.Nodes, mesh.Elements))
        out.flush()
        if mesh.Nodes > 0:
            winner = label
            break
    out.write("WINNER %%s\n" %% winner)
    if winner is not None:
        for s in m.NamedSelections.Children:
            out.write("  ns %%s entities %%d\n" %% (s.Name, len(list(s.Location.Ids))))
        f = codecs.open(r"%s", "w", "utf-8")
        f.write(winner)
        f.close()
except Exception, e:
    out.write("INSIDE ERROR %%s\n" %% e)
finally:
    out.close()
''' % (INNER, FLAG)


def run():
    if not step("1 open v4c", lambda: Open(FilePath=PROJECT)):
        return
    s = GetAllSystems()[0]
    comp = s.GetComponent(Name="Mesh")
    mesh = s.GetContainer(ComponentName="Mesh")
    step("2 meshing: size combinations", lambda: (
        mesh.Edit(Interactive=False),
        mesh.SendCommand(Language="Python", Command=INSIDE),
        mesh.Exit()))
    if File.Exists(FLAG):
        step("3 update mesh component (writes FFF.msh)", lambda: comp.Update(AllDependencies=True))
    else:
        log("3 skipped: no combination produced a mesh")
    step("4 save", lambda: Save(Overwrite=True))


try:
    run()
except System.Exception, ex:
    log("FATAL .NET: " + ex.ToString())
except Exception, e:
    log("FATAL python")
log("END")
