# encoding: utf-8
# auvm_water_v5.wbpj meshed (3.06 M tets) but Fluent min orth 4.9e-4 sits in the two 0.2 mm parallel
# plane gaps at x = 14.8 / 15.0 mm (l2 side face vs l1 at J2, vs link3 at J3). Refine only the local
# face sizings of wall_l1 / wall_l2 / wall_link3 so the gap faces get cells of about the gap width.
# Save as auvm_water_v5b.wbpj first (v5 kept). Combos in one Meshing session, first producing nodes wins:
#   P: l1/l2/link3 0.3 mm (soft)    Q: 0.5 mm    R: 0.3 mm with local growth 1.1
SetScriptVersion(Version="24.2.133")
import System
from System.IO import File
from System.Text import Encoding

D = r"D:\work4\new_model_sim\09_seal_j2j3"
TRACE = D + r"\wb_mesh_v5b_trace.txt"
SOURCE_PROJECT = D + r"\auvm_water_v5.wbpj"
PROJECT = D + r"\auvm_water_v5b.wbpj"
INNER = D + r"\mesh_v5b_messages.txt"
FLAG = D + r"\mesh_v5b_success.txt"
NL = System.Environment.NewLine


def log(s):
    File.AppendAllText(TRACE, System.String.Concat(s, NL), Encoding.UTF8)


def step(label, fn):
    log(label)
    try:
        fn()
        log("  OK")
        return True
    except System.Exception, ex:
        log("  .NET ERROR:")
        log(ex.ToString()[:3000])
    except Exception, e:
        log("  python ERROR")
        try:
            log(e.clsException.ToString()[:3000])
        except Exception:
            log("  (no text)")
    return False


INSIDE = r'''
import codecs
out = codecs.open(r"%s", "w", "utf-8")
COMBOS = [("P", "0.3 [mm]", None), ("Q", "0.5 [mm]", None), ("R", "0.3 [mm]", 1.1)]
try:
    m = ExtAPI.DataModel.Project.Model
    mesh = m.Mesh
    sz = dict((c.Name, c) for c in mesh.Children if c.GetType().Name == "Sizing")
    out.write("sizings %%s\n" %% sorted(sz))
    targets = [sz["size_wall_l1"], sz["size_wall_l2"], sz["size_wall_link3"]]
    def put(obj, name, value):
        try:
            setattr(obj, name, value)
            return "%%s=%%s" %% (name, getattr(obj, name))
        except Exception, e:
            return "FAILED %%s:%%s" %% (name, e)
    winner = None
    for label, size, growth in COMBOS:
        sets = []
        for t in targets:
            sets.append(t.Name + ":" + put(t, "ElementSize", Quantity(size)))
            if growth is not None:
                sets.append(t.Name + ":" + put(t, "GrowthRate", growth))
        out.write("== combo %%s : %%s\n" %% (label, "; ".join(sets)))
        n0 = len(list(ExtAPI.Application.Messages))
        mesh.ClearGeneratedData()
        try:
            mesh.GenerateMesh()
        except Exception, e:
            out.write("   GenerateMesh raised %%s\n" %% e)
        msgs = list(ExtAPI.Application.Messages)
        for msg in msgs:
            if msg.Severity.ToString() != "Warning":
                out.write("   [%%s] %%s\n" %% (msg.Severity, msg.DisplayString))
        out.write("   messages before %%d after %%d nodes %%s elements %%s\n" %% (n0, len(msgs), mesh.Nodes, mesh.Elements))
        out.flush()
        if mesh.Nodes > 0:
            winner = label
            break
    out.write("WINNER %%s\n" %% winner)
    if winner is not None:
        for s in m.NamedSelections.Children:
            out.write("  ns %%s entities %%d\n" %% (s.Name, len(list(s.Location.Ids))))
        f = codecs.open(r"%s", "w", "utf-8")
        f.write(winner)
        f.close()
except Exception, e:
    out.write("INSIDE ERROR %%s\n" %% e)
finally:
    out.close()
''' % (INNER, FLAG)


def run():
    if not step("1 open v5", lambda: Open(FilePath=SOURCE_PROJECT)):
        return
    if not step("2 save as v5b (new file)", lambda: Save(FilePath=PROJECT, Overwrite=False)):
        return
    s = GetAllSystems()[0]
    comp = s.GetComponent(Name="Mesh")
    mesh = s.GetContainer(ComponentName="Mesh")
    step("3 meshing: gap-wall sizing combos", lambda: (
        mesh.Edit(Interactive=False),
        mesh.SendCommand(Language="Python", Command=INSIDE),
        mesh.Exit()))
    if File.Exists(FLAG):
        step("4 update mesh component (writes FFF.msh)", lambda: comp.Update(AllDependencies=True))
    else:
        log("4 skipped: no combination produced a mesh")
    step("5 save", lambda: Save(Overwrite=True))


try:
    run()
except System.Exception, ex:
    log("FATAL .NET: " + ex.ToString())
except Exception, e:
    log("FATAL python")
log("END")
