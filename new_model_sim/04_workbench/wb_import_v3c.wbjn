# encoding: utf-8
# Workbench journal: Fluid Flow (Fluent) system, import fluid_domain_v3.scdoc (named selections on),
# update geometry, refresh + update Mesh with default settings, export Fluent mesh, save project.
# Each step is traced. The source .scdoc is only read.
SetScriptVersion(Version="24.2.133")

TRACE = r"D:\work4\new_model_sim\04_workbench\wb_import_v3c_trace.txt"
SCDOC = r"D:\work4\new_model_sim\03_fluid_domain\fluid_domain_v3.scdoc"
PROJECT = r"D:\work4\new_model_sim\04_workbench\auvm_water_v3.wbpj"
MESH_OUT = r"D:\work4\new_model_sim\04_workbench\auvm_water_v3_default.msh"

f_trace = open(TRACE, "w")


def log(msg):
    if isinstance(msg, unicode):
        msg = msg.encode("utf-8")
    f_trace.write(msg + "\n")
    f_trace.flush()


def txt(value):
    try:
        return unicode(value).encode("utf-8")
    except Exception:
        return repr(value)


try:
    log("1 CreateSystem Fluid Flow")
    template1 = GetTemplate(TemplateName="Fluid Flow")
    system1 = template1.CreateSystem()
    log("  system name: " + txt(system1.Name))

    log("2 SetFile geometry")
    geometry1 = system1.GetContainer(ComponentName="Geometry")
    geometry1.SetFile(FilePath=SCDOC)

    log("3 Geometry properties")
    props = geometry1.GetGeometryProperties()
    props.GeometryImportNamedSelections = True
    props.GeometryImportNamedSelectionsFilter = ""
    log("  GeometryImportNamedSelections=" + txt(props.GeometryImportNamedSelections))

    log("4 Update Geometry")
    geometryComponent1 = system1.GetComponent(Name="Geometry")
    geometryComponent1.Update(AllDependencies=True)
    log("  geometry updated")

    log("5 Save project (new file)")
    Save(FilePath=PROJECT, Overwrite=False)
    log("  saved " + PROJECT)

    log("6 Refresh Mesh")
    meshComponent1 = system1.GetComponent(Name="Mesh")
    meshComponent1.Refresh()
    log("  mesh refreshed")

    log("7 Update Mesh (default settings)")
    meshComponent1.Update(AllDependencies=True)
    log("  mesh updated")

    log("8 Export Fluent mesh")
    mesh1 = system1.GetContainer(ComponentName="Mesh")
    mesh1.ExportMesh(FilePath=MESH_OUT)
    log("  exported " + MESH_OUT)

    log("9 Save project")
    Save(Overwrite=True)
    log("DONE")
except Exception, e:
    log("ERROR: " + txt(e))
finally:
    f_trace.close()
