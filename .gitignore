# =========================================================================
# .gitignore for Underwater Vehicle-Manipulator Simulation Toolbox
# =========================================================================

# MATLAB auto-generated and backup files
*.asv
*.autosave
*.m~
slprj/
*.slxc
*.mex*
*.log

# Large Archive packages (models are already unpacked in model/)
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# CAD source tree unpacked from model.zip (~42 MB of SolidWorks binaries).
# The simulation reads model/meshes/*.stl and model/robot.urdf, both exported
# from this tree, so the sources themselves are not needed in the repo.
# Note these are the ONLY copy of the CAD originals -- back them up elsewhere.
/机器人/
*.SLDPRT
*.SLDASM
*.SLDDRW
*.sldprt
*.sldasm
*.slddrw

# OS and IDE caches
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local agent & framework runtime
.narrafork/

# Legacy unorganized working directories (reorganized into model/, src/, docs/, data/)
/papers/
/urdf/

# Personal / administrative documents unrelated to the simulation toolbox
*.docx
*.pdf
~$*

# Surrogate artifacts that run_hydro_surrogate regenerates from fixed seeds.
# The trained model, metrics and comparison figures ARE tracked; the sampled
# datasets and per-row prediction dumps are not, to keep the repo small.
data/hydro_surrogate/**/dataset.mat
data/hydro_surrogate/**/test_predictions.csv
data/hydro_surrogate/smoke/

# Python caches
__pycache__/
*.pyc

# Fluent CFD temporary logs and large simulation mesh/data artifacts
*.trn
*.cas.h5
*.dat.h5
*.cas
*.dat
*.neu
*.scdoc
*.x_t
*.fmd
*.msh.h5
*.msh
*.step
*.STEP
*.wbpj
cleanup-fluent-*
FM_KIM_*
libudf*/
*.obj
*.dll
*.lib
*.exp
*.sconsign*
.sab
/assemble_cmd.txt
/exact_physics_full_cmd.txt
/make_valid_cmd.txt
/arm_motion.c
/arm_motion_config.h
/test_motion.c
cfd/.1_files.backup/
cfd/wetted_arm_rebuild/
cfd/1_files/
cfd/**/solve_*
cfd/**/test_*
cfd/**/trial_*
cfd/**/cad_attempt*
cfd/**/assembled_*
cfd/**/native_verification
cfd/**/focused_*
cfd/**/lightweight_*
cfd/**/robust_*
cfd/**/reduced_*
cfd/**/probe_*
cfd/.mcp-venv*
cfd/test_*.py
cfd/test_*.neu
cfd/test_*.jou
cfd/probe_*.py
cfd/check_*.py
cfd/check_*.m
cfd/diagnose_*.py
cfd/inspect_*.py
cfd/eval_*.py
cfd/debug_*.py
cfd/debug_*.m
